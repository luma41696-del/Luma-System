# =============================================================================
# Luma Agency — server-side secrets
# -----------------------------------------------------------------------------
# Copy to functions/.env for LOCAL development only:
#     cp .env.example functions/.env
#
# In production these values must live in Google Secret Manager, NOT in a file:
#     firebase functions:secrets:set VAULT_ENCRYPTION_KEY
#
# Nothing in this file may ever appear in frontend code, in the browser bundle,
# or in version control. functions/.env is git-ignored.
# =============================================================================

# --- Credential vault ---------------------------------------------------------
# AES-256-GCM key: exactly 32 bytes, hex (64 chars) or base64 (44 chars).
# Generate one with:
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this key makes every existing vault entry undecryptable — re-enter
# the credentials after a rotation.
VAULT_ENCRYPTION_KEY=

# --- Admin SDK credentials (seed scripts only) --------------------------------
# Absolute path to a service-account JSON downloaded from
# Firebase Console → Project settings → Service accounts.
# Never commit this file. Delete it from the machine once seeding is finished.
GOOGLE_APPLICATION_CREDENTIALS=

# --- Initial administrator (consumed by functions/scripts/seed-admin.js) ------
LUMA_PROJECT_ID=luma-web-d3550
LUMA_ADMIN_USERNAME=admin
LUMA_ADMIN_NAME=مدير النظام
LUMA_ADMIN_EMAIL=
# The temporary password handed to the administrator. Set it here (or in your
# shell) just long enough to run the seed script, then remove it.
LUMA_ADMIN_TEMP_PASSWORD=

# --- Demo data (functions/scripts/seed-demo.js) -------------------------------
# Shared temporary password for every demo account. Demo accounts are all
# flagged mustChangePassword.
LUMA_DEMO_PASSWORD=

# =============================================================================
# Public client identifiers (NOT secrets — safe in frontend code)
# -----------------------------------------------------------------------------
# These belong in the browser, set on window before js/firebase-config.js loads.
# They are listed here only so all configuration is documented in one place.
# =============================================================================

# reCAPTCHA v3 site key for App Check
#   Console → App Check → Apps → Web → reCAPTCHA v3
# In the page:  <script>window.__LUMA_APPCHECK_SITE_KEY__ = "6Lxxxxxx...";</script>
LUMA_APPCHECK_SITE_KEY=

# Web Push public key (VAPID)
#   Console → Project settings → Cloud Messaging → Web configuration
# In the page:  <script>window.__LUMA_FCM_VAPID_KEY__ = "BLxxxxxx...";</script>
LUMA_FCM_VAPID_KEY=

# ----------------------------------------------------------------- AI
# Three providers are supported. Set a key for each one you want available;
# a provider with no key here is shown in Settings → المساعد الذكي but cannot
# be selected, and with no key at all the assistants report themselves as
# disabled while the rest of the system is unaffected.
#
# WHICH provider is in use is NOT set here — it is chosen in the settings
# screen and stored in Firestore (settings/ai), so switching needs no redeploy.
# Only the keys belong in the environment, and they never leave it.

# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Per-provider model default, used only until one is picked in the settings
# screen. Leave unset to take the default from functions/ai/catalog.js.
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=
GEMINI_MODEL=

# Fallback provider when settings/ai has no choice saved yet.
AI_PROVIDER=openai

# How hard Claude thinks before answering. These assistants summarise data a
# tool already computed and must finish inside the 20s budget, so `low` is the
# default; raise to medium/high if answers feel shallow.
ANTHROPIC_EFFORT=low
