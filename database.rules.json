{
  "rules": {
    ".read": false,
    ".write": false,

    "status": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['state', 'lastChanged'])",
        "state": {
          ".validate": "newData.isString() && newData.val().matches(/^(online|working|break|offline)$/)"
        },
        "lastChanged": { ".validate": "newData.val() === now || newData.val() <= now + 5000" },
        "breakStartedAt": { ".validate": "newData.isNumber() || newData.val() === null" },
        "todayBreakMs": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "displayName": { ".validate": "newData.isString() && newData.val().length <= 120" },
        "photoURL": { ".validate": "newData.isString() && newData.val().length <= 600" },
        "device": { ".validate": "newData.isString() && newData.val().length <= 120" },
        "$other": { ".validate": false }
      }
    },

    "typing": {
      "$chatId": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isNumber() || newData.val() === null"
        }
      }
    },

    "presenceMeta": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        "lastSeen": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    }
  }
}
